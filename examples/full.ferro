fn double(x: i64) -> i64 {
    return x + x;
}

fn add_then_double(a: i64, b: i64) -> i64 {
    let sum: i64 = a + b;
    return double(sum);
}

fn main() {
    let result: i64 = add_then_double(3, 4);
    print(result);

    let mut total: i64 = 0;
    let mut i: i64 = 1;
    while i <= 5 {
        total = total + double(i);
        i = i + 1;
    }
    print(total);
}
