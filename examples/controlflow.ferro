// Control Flow Demo — for loops, break, continue, match

fn fizzbuzz(n: i64) {
    for i in 1..n {
        if i % 15 == 0 {
            print("FizzBuzz");
        } else {
            if i % 3 == 0 {
                print("Fizz");
            } else {
                if i % 5 == 0 {
                    print("Buzz");
                } else {
                    print(i);
                }
            }
        }
    }
}

fn describe(x: i64) {
    match x {
        0 => { print("zero"); }
        1 => { print("one"); }
        2 => { print("two"); }
        _ => { print("other"); }
    }
}

fn main() {
    // For loop: sum 1..10
    let mut sum: i64 = 0;
    for i in 1..11 {
        sum = sum + i;
    }
    print(sum);

    // Break: find first multiple of 7
    for i in 1..100 {
        if i % 7 == 0 {
            print(i);
            break;
        }
    }

    // Continue: skip multiples of 3
    for i in 1..10 {
        if i % 3 == 0 { continue; }
        print(i);
    }

    // Match
    describe(0);
    describe(1);
    describe(99);

    // FizzBuzz 1..16
    fizzbuzz(16);
}
