{
    "name": "Ferro",
    "scopeName": "source.ferro",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#char_literals" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#builtins" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ferro",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ferro",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ferro",
                            "match": "\\\\[nrt\\\\\"0]"
                        }
                    ]
                }
            ]
        },
        "char_literals": {
            "patterns": [
                {
                    "name": "string.quoted.single.ferro",
                    "match": "'(\\\\[nrt\\\\'0]|[^'\\\\])'"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.ferro",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ferro",
                    "match": "\\b(if|else|while|for|in|match|break|continue|return|try|fail|defer|import)\\b"
                },
                {
                    "name": "keyword.other.ferro",
                    "match": "\\b(fn|let|mut|struct|enum|comptime|priv|as)\\b"
                },
                {
                    "name": "constant.language.boolean.ferro",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.ferro",
                    "match": "\\b(i64|f64|bool|str|void)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.ferro",
                    "match": "\\b(print|len|abs|min|max|pow|rand|to_str|parse_int|char_at|substr|contains|starts_with|trim|read_line|read_file|write_file|file_exists|eprint|exit|time|sleep|alloc|free)\\b(?=\\s*\\()"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.ferro",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.ferro" }
                    }
                },
                {
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.ferro" },
                        "2": { "name": "entity.name.function.definition.ferro" }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pipe.ferro",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.arrow.ferro",
                    "match": "->|=>"
                },
                {
                    "name": "keyword.operator.range.ferro",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.comparison.ferro",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.ferro",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.ferro",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.assignment.ferro",
                    "match": "="
                },
                {
                    "name": "keyword.operator.path.ferro",
                    "match": "::"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.section.braces.ferro",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.section.brackets.ferro",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "punctuation.section.parens.ferro",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.separator.ferro",
                    "match": "[;:,]"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.ferro",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
